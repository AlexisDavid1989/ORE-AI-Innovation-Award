{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Copilot Usage Report",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.github/copilot-usage/generate-copilot-usage-report.ps1",
        "-WorkspacePath",
        "${workspaceFolder}",
        "-OutJson",
        "${workspaceFolder}/.github/copilot-usage/usage-summary.json",
        "-OutMarkdown",
        "${workspaceFolder}/COPILOT_USAGE_REPORT.md",
        "-OutTranscript",
        "${workspaceFolder}/.github/copilot-usage/prompt-answer-log.jsonl"
      ],
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
